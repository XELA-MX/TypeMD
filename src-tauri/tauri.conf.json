{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeMD",
  "version": "0.1.0",
  "identifier": "com.typemd.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TypeMD",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Minimalist WYSIWYG markdown editor",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
